{
  "name": "automation-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para sistemas de automatización de procesos",
  "scripts": {
    "n8n:up": "docker compose -f workflows/n8n/docker-compose.yml up -d",
    "n8n:down": "docker compose -f workflows/n8n/docker-compose.yml down",
    "n8n:logs": "docker compose -f workflows/n8n/docker-compose.yml logs -f n8n",
    "form:serve": "npx serve apps/form -l 3000",
    "new-client": "bash scripts/new-client.sh"
  }
}
