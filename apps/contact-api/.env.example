# Notion — notion.so/my-integrations
NOTION_API_KEY=ntn_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_DB_CONTACTS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx                  # ID de la base de datos de Contacts

# Resend — resend.com
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TO_EMAIL=tu@email.com                                                # Dirección donde recibirás las notificaciones
FROM_EMAIL=leads@tudominio.com                                       # Debe ser un dominio verificado en Resend

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo puedes dejarlo vacío (acepta todos)
# En producción pon la URL de tu portfolio: https://tuportfolio.com
# En producción es obligatorio: CORS_ORIGINS=https://tuportfolio.com
CORS_ORIGINS=