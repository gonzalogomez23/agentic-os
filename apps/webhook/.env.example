# Notion — notion.so/my-integrations
NOTION_API_KEY=
NOTION_DB_LEADS=                # ID de la base de datos de Leads

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo puedes dejarlo vacío (acepta todos)
# En producción pon la URL de tu portfolio: https://tuportfolio.com
CORS_ORIGINS=
