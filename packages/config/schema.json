{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Client Config",
  "type": "object",
  "required": ["business", "branding", "form", "n8n", "contact"],
  "properties": {
    "business": {
      "type": "object",
      "required": ["name", "type", "timezone", "locale"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string" },
        "locale": { "type": "string" }
      }
    },
    "branding": {
      "type": "object",
      "required": ["primaryColor", "formTitle"],
      "properties": {
        "primaryColor": { "type": "string" },
        "formTitle": { "type": "string" },
        "formSubtitle": { "type": "string" },
        "welcomeEmailSubject": { "type": "string" }
      }
    },
    "form": {
      "type": "object",
      "required": ["memberships", "goals"],
      "properties": {
        "fields": { "type": "object" },
        "memberships": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "goals": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "n8n": {
      "type": "object",
      "required": ["webhookPath"],
      "properties": {
        "webhookPath": { "type": "string" },
        "notionDatabaseId": { "type": "string" },
        "telegramChatId": { "type": "string" },
        "fromEmail": { "type": "string" }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "schedule": {
          "type": "object",
          "properties": {
            "weekdays": { "type": "string" },
            "saturday": { "type": "string" },
            "sunday": { "type": "string" }
          }
        }
      }
    }
  }
}
